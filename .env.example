# --- LLM provider keys (fill in whichever you'll use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Which provider powers the target LLM and the evaluator LLM ---
TARGET_LLM_PROVIDER=anthropic        # openai | anthropic | gemini | local
EVALUATOR_LLM_PROVIDER=anthropic
TARGET_LLM_MODEL=claude-sonnet-4-6
EVALUATOR_LLM_MODEL=claude-haiku-4-5

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-before-deploying
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./data/logs/promptshield.db

# --- Risk thresholds (mirrors config.yaml, env overrides win) ---
RISK_PASS_MAX=30
RISK_REWRITE_MAX=65

# --- Rate limiting / performance ---
MAX_REQUEST_LATENCY_MS=200
