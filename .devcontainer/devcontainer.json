{
  "name": "PromptShield X",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PromptShield API + Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && cp -n .env.example .env && python -m app.core.init_db",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}"
  }
}
